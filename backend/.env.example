# Keep the real .env file private. Production deployment reads the SoCLaaS key
# and base URL from Springboot/infra/aws/deployment.env.
SOCLAAS_API_KEY=
SOCLAAS_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1
SOCLAAS_CHAT_MODEL=default
SOCLAAS_VISION_MODEL=advanced-vision

SECRET_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ALLOWED_ORIGIN_PRODUCTION=https://linked-expense-tracker.vercel.app
ALLOWED_ORIGIN_DEVELOPMENT=http://localhost:3000
PORT=8000
LOG_LEVEL=info

SPREADSHEET_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
